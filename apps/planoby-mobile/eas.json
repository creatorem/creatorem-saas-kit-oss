{
    "cli": {
        "appVersionSource": "remote",
        "promptToConfigurePushNotifications": false
    },
    "build": {
        "monorepo": {
            "pnpm": "9.12.0",
            "env": {
                "EXPO_USE_FAST_RESOLVER": "true"
            },
            "channel": "monorepo"
        },
        "development-simulator": {
            "developmentClient": true,
            "distribution": "internal",
            "ios": {
                "simulator": true
            },
            "channel": "development-simulator"
        },
        "development": {
            "developmentClient": true,
            "environment": "development",
            "extends": "monorepo",
            "distribution": "internal",
            "autoIncrement": true,
            "android": {
                "buildType": "apk"
            },
            "ios": {
                "resourceClass": "m-medium"
            },
            "channel": "development"
        },
        "preview": {
            "environment": "preview",
            "extends": "monorepo",
            "distribution": "internal",
            "channel": "preview",
            "autoIncrement": true,
            "android": {
                "buildType": "apk"
            },
            "ios": {
                "resourceClass": "m-medium"
            }
        },
        "production": {
            "environment": "production",
            "extends": "monorepo",
            "distribution": "store",
            "autoIncrement": true,
            "android": {
                "buildType": "app-bundle"
            },
            "ios": {
                "resourceClass": "m-medium"
            },
            "channel": "production"
        }
    },
    "submit": {
        "production": {}
    }
}
